# Copy this file to .env and fill in your own credentials.
# Never commit the resulting .env file.

# Endpoint used for every model whose name starts with "qwen"
# (Qwen2-72B-Instruct is the backbone used in the paper, Qwen-Long the
# long-context retriever).
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=

# OpenAI-compatible endpoint used for every other model, including the
# GPT-4 judge of the evaluation script.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
